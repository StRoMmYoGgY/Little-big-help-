{
  "entities": {
    "Campaign": {
      "title": "Campaign",
      "description": "Marketing campaign draft or published post for Little Big Help",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the campaign"
        },
        "title": {
          "type": "string",
          "description": "Human-readable title of the campaign"
        },
        "serviceCategory": {
          "type": "string",
          "description": "Service category (e.g. Everyday Help, Local Assistance, Website Design)"
        },
        "targetAudience": {
          "type": "string",
          "description": "Target demographic for the campaign"
        },
        "goal": {
          "type": "string",
          "description": "Primary conversion or brand objective"
        },
        "aspectRatio": {
          "type": "string",
          "description": "Image aspect ratio (e.g. 1:1, 4:5)"
        },
        "headline": {
          "type": "string",
          "description": "Punchy headline for visual banner"
        },
        "hook": {
          "type": "string",
          "description": "Initial attention-grabbing copy"
        },
        "bodyCopy": {
          "type": "string",
          "description": "Detailed promotional message and value propositions"
        },
        "callToAction": {
          "type": "string",
          "description": "Call to action prompt"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "scheduled", "published"],
          "description": "Workflow lifecycle state of the campaign"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "title", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System and social integration configuration settings",
      "type": "object",
      "properties": {
        "authorizedAdminEmail": {
          "type": "string",
          "description": "Authorized administrator email address"
        },
        "facebookPageId": {
          "type": "string",
          "description": "Connected Facebook Page ID"
        },
        "instagramAccountId": {
          "type": "string",
          "description": "Connected Instagram Professional Account ID"
        },
        "metaAppId": {
          "type": "string",
          "description": "Meta App ID"
        },
        "metaConnected": {
          "type": "boolean",
          "description": "Whether live Meta connection is established"
        },
        "timezone": {
          "type": "string",
          "description": "Default timezone for scheduling"
        }
      },
      "required": ["authorizedAdminEmail"]
    },
    "Session": {
      "title": "Session",
      "description": "Persistent authenticated administrator session record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Administrator email"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Admin status"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "lastActiveAt": {
          "type": "number",
          "description": "Last active timestamp in milliseconds"
        }
      },
      "required": ["email", "isAdmin", "createdAt"]
    }
  },
  "firestore": {
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Stores all marketing campaigns, creative content, and publication states"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Stores administrative and integration settings"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Stores persistent administrator session records that survive container restarts"
    }
  }
}
