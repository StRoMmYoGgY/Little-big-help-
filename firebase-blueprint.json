{
  "entities": {
    "Campaign": {
      "title": "Campaign",
      "description": "Marketing campaign draft or published post for ALLORA",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the campaign"
        },
        "title": {
          "type": "string",
          "description": "Human-readable title of the campaign"
        },
        "serviceCategory": {
          "type": "string",
          "description": "Service category (e.g. Personal Concierge, Local Assistance, Business Support, Digital Solutions)"
        },
        "targetAudience": {
          "type": "string",
          "description": "Target demographic for the campaign"
        },
        "goal": {
          "type": "string",
          "description": "Primary conversion or brand objective"
        },
        "aspectRatio": {
          "type": "string",
          "description": "Image aspect ratio (e.g. 1:1, 4:5)"
        },
        "headline": {
          "type": "string",
          "description": "Editorial headline for visual banner"
        },
        "hook": {
          "type": "string",
          "description": "Initial attention-grabbing copy"
        },
        "bodyCopy": {
          "type": "string",
          "description": "Detailed promotional message and value propositions"
        },
        "callToAction": {
          "type": "string",
          "description": "Call to action prompt"
        },
        "status": {
          "type": "string",
          "enum": ["draft", "approved", "scheduled", "published"],
          "description": "Workflow lifecycle state of the campaign"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "title", "status", "createdAt"]
    },
    "Inquiry": {
      "title": "Inquiry",
      "description": "Customer service and concierge inquiry submitted through ALLORA website",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the customer inquiry"
        },
        "customerName": {
          "type": "string",
          "maxLength": 120,
          "description": "Name of the customer or business"
        },
        "whatsappNumber": {
          "type": "string",
          "maxLength": 40,
          "description": "Customer WhatsApp contact number"
        },
        "email": {
          "type": "string",
          "maxLength": 160,
          "description": "Optional email address"
        },
        "serviceCategory": {
          "type": "string",
          "maxLength": 100,
          "description": "Requested service category"
        },
        "location": {
          "type": "string",
          "maxLength": 200,
          "description": "City, neighborhood, or coordination area"
        },
        "taskDescription": {
          "type": "string",
          "maxLength": 3000,
          "description": "Primary description of the requested task or assistance"
        },
        "preferredDate": {
          "type": "string",
          "maxLength": 60,
          "description": "Preferred date or timeline"
        },
        "additionalDetails": {
          "type": "string",
          "maxLength": 2000,
          "description": "Additional context, notes, or website scope details"
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_review", "confirmed", "completed", "archived"],
          "description": "Inquiry handling status"
        },
        "adminNotes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Internal coordinator notes"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Submission timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "customerName", "whatsappNumber", "serviceCategory", "taskDescription", "status", "createdAt"]
    },
    "Setting": {
      "title": "Setting",
      "description": "System and social integration configuration settings",
      "type": "object",
      "properties": {
        "authorizedAdminEmail": {
          "type": "string",
          "description": "Authorized administrator email address"
        },
        "facebookPageId": {
          "type": "string",
          "description": "Connected Facebook Page ID"
        },
        "instagramAccountId": {
          "type": "string",
          "description": "Connected Instagram Professional Account ID"
        },
        "metaAppId": {
          "type": "string",
          "description": "Meta App ID"
        },
        "metaConnected": {
          "type": "boolean",
          "description": "Whether live Meta connection is established"
        },
        "timezone": {
          "type": "string",
          "description": "Default timezone for scheduling"
        }
      },
      "required": ["authorizedAdminEmail"]
    },
    "Session": {
      "title": "Session",
      "description": "Persistent authenticated administrator session record",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Administrator email"
        },
        "isAdmin": {
          "type": "boolean",
          "description": "Admin status"
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp in milliseconds"
        },
        "lastActiveAt": {
          "type": "number",
          "description": "Last active timestamp in milliseconds"
        }
      },
      "required": ["email", "isAdmin", "createdAt"]
    }
  },
  "firestore": {
    "/campaigns/{campaignId}": {
      "schema": "Campaign",
      "description": "Stores all marketing campaigns, creative content, and publication states"
    },
    "/inquiries/{inquiryId}": {
      "schema": "Inquiry",
      "description": "Stores customer service inquiries submitted from the ALLORA website"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Stores administrative and integration settings"
    },
    "/sessions/{sessionId}": {
      "schema": "Session",
      "description": "Stores persistent administrator session records that survive container restarts"
    }
  }
}
