# Little Big Help - Server Environment Configuration
# Copy this file to .env and customize with your private values.
# NEVER commit .env to source control.

PORT=3000
NODE_ENV=development

# Administrator Authentication (Priority 1)
# Strict administrator access is limited to this designated email address
ADMIN_EMAIL=orghosimsung@gmail.com

# Administrator Access Passcode
# Set a strong, private passcode for dashboard login. If not set, a secure temporary key will be generated on boot.
ADMIN_PASSCODE=

# Secret key used for cryptographic session signature and token hashing (min 32 characters)
ADMIN_SESSION_SECRET=

# Google Gemini API Key (for AI Social Media Campaign Generation)
GEMINI_API_KEY=

# Meta Graph API Settings (v26.0)
# Configure via admin dashboard or define server-side fallbacks here
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_INSTAGRAM_ACCOUNT_ID=
META_APP_ID=
META_APP_SECRET=
